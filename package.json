{
  "name": "ai-agent-video-editor-gemini",
  "version": "0.1.0",
  "description": "Gemini-powered agent for video editing workflows",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "video-use": "./dist/cli/index.js",
    "ai-agent-video-editor-gemini": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "exports": {
    ".": {
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
